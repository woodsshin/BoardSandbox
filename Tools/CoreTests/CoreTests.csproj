<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CoreTests</AssemblyName>
    <RootNamespace>BoardSandbox.CoreTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UnityEngineDll Condition="'$(UnityEngineDll)' == ''">$(MSBuildThisFileDirectory)../UnityCheck/.reference/UnityEngine.dll</UnityEngineDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/BoardSandbox/Runtime/Core/**/*.cs" />
    <Compile Include="../../Assets/BoardSandbox/Tests/Editor/**/*.cs" Exclude="../../Assets/BoardSandbox/Tests/Editor/Client/**/*.cs" />
    <Compile Include="NUnitShim.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(UnityEngineDll)')">
    <Compile Include="../../Assets/BoardSandbox/Runtime/Client/Geometry/**/*.cs" />
    <Compile Include="../../Assets/BoardSandbox/Runtime/Client/Views/ViewHints.cs" />
    <Compile Include="../../Assets/BoardSandbox/Runtime/Client/Views/ObjectLook.cs" />
    <Compile Include="../../Assets/BoardSandbox/Runtime/Client/Views/StageSettings.cs" />
    <Compile Include="../../Assets/BoardSandbox/Runtime/Client/Views/BoardState.cs" />
    <Compile Include="../../Assets/BoardSandbox/Tests/Editor/Client/**/*.cs" />
    <Reference Include="UnityEngine">
      <HintPath>$(UnityEngineDll)</HintPath>
    </Reference>
  </ItemGroup>

</Project>
